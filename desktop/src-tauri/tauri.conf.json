{
  "productName": "llmusage",
  "version": "1.3.0",
  "identifier": "com.bahayonghang.llmusage",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "llmusage",
        "width": 1280,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"]
  },
  "plugins": {
    "single-instance": {}
  }
}
